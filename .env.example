# Copy this file to `.env` (never commit `.env` — it's already in
# .gitignore) and fill in real values. orchestration/pipeline.py calls
# load_dotenv() on import, so anything set here is picked up
# automatically for local runs; on Cloud Run these are set instead via
# `gcloud run deploy --set-env-vars` / `--set-secrets` (see README).

# --- Required ---

# Parallel Search API key. Get one at https://platform.parallel.ai
# Used by every agents/*_agent.py that calls parallel.search().
PARALLEL_API_KEY=

# YouTube Data API v3 key. Get one from the Google Cloud Console
# (APIs & Services -> Credentials) with the YouTube Data API v3 enabled
# on the project. Used by youtube_discovery_agent.py / youtube_data_agent.py.
YOUTUBE_API_KEY=

# --- Gemini access: pick ONE of the two setups below ---

# Option A — Vertex AI (routes through your GCP project's own billing):
GOOGLE_GENAI_USE_VERTEXAI=True
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=us-central1

# Option B — AI Studio (a separate prepay balance, no GCP project needed):
# GOOGLE_GENAI_USE_VERTEXAI=False
# GEMINI_API_KEY=

# --- Optional ---

# Overrides the Gemini model used for every agent call. Verify this
# against your own project/region before trusting it — model
# availability differs between AI Studio and Vertex, and between
# projects. Defaults to gemini-2.5-flash if unset.
# FILMECHO_GEMINI_MODEL=gemini-2.5-flash

# Sampling temperature applied to every agent's generate_content_config.
# Lower = more consistent/grounded, less creative. Defaults to 0.1.
# FILMECHO_TEMPERATURE=0.1

# How long (in seconds) an upcoming/unclear-release-status memo stays
# cached before a repeat search re-runs the full pipeline. Released
# titles are always cached indefinitely regardless of this value.
# Defaults to 1200 (20 minutes).
# FILMECHO_UPCOMING_CACHE_TTL_SECONDS=1200
